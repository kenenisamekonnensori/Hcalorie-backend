generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?
  googleId  String?  @unique
  meals     Meal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     Token[]

  @@map("users")
}

model Token {
  id        String   @id @default(cuid())
  userId    String 
  token     String   @unique
  type      TokenType
  createdAt DateTime @default(now())
  expiresAt DateTime 
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

enum TokenType {
  REFRESH
}


model Meal {
  id          String         @id @default(cuid())
  userId      String
  name        String
  consumedAt  DateTime       @default(now())
  calories    Int            @default(0)
  mealEntries MealEntry[]
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
}

model MealEntry {
  id           String   @id @default(cuid())
  mealId       String
  foodName     String
  calories     Int
  proteinGrams Float?
  carbsGrams   Float?
  fatGrams     Float?
  meal         Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mealId])
}
